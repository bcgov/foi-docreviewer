ENVIRONMENT=development

# Health probe server
HEALTH_PORT=8000

# Redis Streams
REDIS_STREAM_URL=redis://localhost:6379/1
STREAM_NAME=preprocessing
CONSUMER_GROUP=preprocessing_v1
OUTPUT_STREAM_NAME=
STREAM_POLL_INTERVAL_MS=1000

# Consumer reliability
CONSUMER_BATCH_SIZE=10
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_BACKOFF_MS=500
CONSUMER_CLAIM_MIN_IDLE_MS=600000
DLQ_STREAM_NAME=

# Handler state store
STATE_TTL_SECONDS=3600

# PDF processing
WORK_DIR=/tmp/pdf-preprocessing
MAX_PDF_BYTES=2000000000
S3_CONNECT_TIMEOUT_SECONDS=10
S3_READ_TIMEOUT_SECONDS=60
S3_MAX_ATTEMPTS=3

# AWS credentials + region are read by boto3 directly from the standard chain,
# not through Settings.
S3_ENDPOINT_URL=https://objectstore
S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OUTPUT_FILENAME_SUFFIX=PREPROCESSED

# Logging
LOG_LEVEL=INFO
JSON_LOGS=false

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_ENDPOINT_ENABLE_FALLBACK=False
