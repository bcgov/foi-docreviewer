##### DEDUPE ENV VAR STARTS HERE #####################
DEDUPE_REDIS_HOST=
DEDUPE_REDIS_PASSWORD=
DEDUPE_REDIS_PORT=
DEDUPE_STREAM_KEY=FOIDEDUPE-local-{add initials here}
DEDUPE_CONSUMER_GROUP=dedupe
DEDUPE_CONSUMER_NAME=
DEDUPE_CONSUMER_BATCH_SIZE=10
DEDUPE_CONSUMER_BLOCK_MS=5000
DEDUPE_CONSUMER_MAX_RETRIES=5
DEDUPE_CONSUMER_RETRY_BACKOFF_MS=250
DEDUPE_CONSUMER_CLAIM_MIN_IDLE_MS=60000
DEDUPE_DLQ_STREAM=foi:dedupe.dlq
DEDUPE_DLQ_MAXLEN=10000
## Optional, one-shot legacy checkpoint cutover key. Leave empty (default)
## to disable legacy seeding; never point this at the shared "$:lastid" key
## used by other still-legacy services/deployments.
DEDUPE_LEGACY_CHECKPOINT_KEY=
COMPRESSION_MESSAGING_MODE=legacy
MESSAGING_STREAM_PREFIX=foi
COMPRESSION_TOPIC=compression
COMPRESSION_WORKLOAD=normal
COMPRESSION_PROCESSING_TIMEOUT=15m
MESSAGING_CONSUMER_GROUP=foi-compression-normal
MESSAGING_CLAIM_INTERVAL=30s
MESSAGING_CLAIM_MIN_IDLE=17m
MESSAGING_MAX_DELIVERY_ATTEMPTS=5
MESSAGING_SHUTDOWN_TIMEOUT=25s
COMPRESSION_STREAM_KEY=FOICOMPRESSION-local-{add initials here}
COMPRESSION_CHECKPOINT_KEY=FOICOMPRESSION-CHECKPOINT-local-{add initials here}
NOTIFICATION_STREAM_KEY=FOINOTIFICATION-local-{add initials here}
DEDUPE_S3_ENV=dev ## dev | test | prod  - this is as suffix on bucket name

DEDUPE_DB_HOST=
DEDUPE_DB_NAME=
DEDUPE_DB_PORT=
DEDUPE_DB_USER=
DEDUPE_DB_PASSWORD=

DEDUPE_S3_HOST=
DEDUPE_S3_REGION=
DEDUPE_S3_SERVICE=

DEDUPE_RECORD_FORMATS=

##### DEDUPE ENV VAR ENDS HERE #####################

