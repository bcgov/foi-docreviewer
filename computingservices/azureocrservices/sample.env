# S3-compatible object storage
s3endpoint=
s3accesskey=
s3secretkey=
s3region=us-east-1

# Azure Document Intelligence
azuresubcriptionkey=
azuredocumentocraiendpoint=

# ActiveMQ REST API
# activeMQBaseURL must end with "destination=queue"; the code appends "://<queue>&clientId=<id>"
activeMQBaseURL=
activeMQUserName=
activeMQPassword=
foidococrqueue=
activemqclientid=

# Reviewer API status callback
docreviewerocrapiendpoint=
docreviewerocrapisecret=

# Directory for daily log files (<YYYY-M-D>dococrlog.txt); include trailing slash
logfilepath=
