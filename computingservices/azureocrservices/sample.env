# S3-compatible object storage
s3endpoint=
s3accesskey=
s3secretkey=
s3region=us-east-1

# Azure Document Intelligence
azuresubcriptionkey=
azuredocumentocraiendpoint=

# ActiveMQ REST API
# activeMQBaseURL must end with "destination=queue"; the code appends "://<queue>&clientId=<id>"
activeMQBaseURL=
activeMQUserName=
activeMQPassword=
foidococrqueue=
activemqclientid=

# Reviewer API status callback
docreviewerocrapiendpoint=
docreviewerocrapisecret=

# Directory for daily log files (<YYYY-M-D>dococrlog.txt); include trailing slash
logfilepath=

# ---- Batch pipeline (docs/superpowers/specs/2026-09-19-azure-ocr-batch-pipeline-design.md) ----
# Every key below is optional; the default reproduces the pre-pipeline behaviour.
# Recommended production values are in the comment after each default.

# Batch / concurrency
activemqbatchsize=0             # messages pulled per run; 0 = until the queue is empty   (recommended: 20)
maxconcurrentocrjobs=1          # documents processed in parallel                          (recommended: 5)
ocruploadconcurrency=1          # concurrent S3 PUTs                                       (recommended: 3)

# Azure request pacing
azureanalyzeratelimit=0         # Analyze POSTs per second across all workers; 0 = unlimited (recommended: 2)
azurepollintervalseconds=5      # base delay between status polls; Retry-After overrides
azurepollmaxattempts=120        # give up polling after this many status reads (120 x 5 s = 10 min)
azuremaxretries=0               # retries per HTTP call on 429/5xx/transport error; 0 = none  (recommended: 5)
azureretrybaseseconds=2         # backoff base: min(base * 2^n + jitter, azureretrymaxseconds)
azureretrymaxseconds=60

# Per-document guard rail
ocrjobtimeoutseconds=900        # hard deadline for download -> upload of one document

# Transport timeouts (seconds)
azurehttptimeoutseconds=120
s3httptimeoutseconds=120
reviewerapitimeoutseconds=30
activemqhttptimeoutseconds=30

# Source delivery: true = base64Source (default); false = urlSource with a presigned GET
# (only if Azure can reach the S3 endpoint from the internet)
azureusebase64source=true

# Overlap guard; default <logfilepath>azureocrservice.lock
runlockpath=
