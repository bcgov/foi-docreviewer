FROM python:3.13.17-trixie@sha256:d5a186865324088bd10d1671801b42297a8fe3f8059143fb22b2e2b776ffa6dd
RUN apt-get update \
    && apt-get install -y --no-install-recommends --only-upgrade libunbound8=1.26.2-0+deb13u1 \
    && rm -rf /var/lib/apt/lists/*
EXPOSE 6402
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN python -m pip install --no-cache-dir --require-hashes -r requirements.txt
COPY . /app
ENTRYPOINT ["/bin/sh", "/app/entrypoint.sh"]
